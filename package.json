{
  "name": "foliole",
  "version": "0.1.0",
  "description": "Desktop knowledge workspace for local reading and review.",
  "author": "Foliole",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "npm@11.12.0",
  "type": "module",
  "main": "electron-dist/electron/main.js",
  "scripts": {
    "dev": "npm run appearance:colors:generate && vite",
    "build": "npm run appearance:colors:generate && tsc -b && vite build",
    "preview": "vite preview",
    "appearance:colors:generate": "node --experimental-strip-types scripts/generate-appearance-colors.ts",
    "appearance:colors:check": "node --experimental-strip-types scripts/generate-appearance-colors.ts --check",
    "deps:scan": "knip --dependencies --reporter compact",
    "deps:hardening:check": "bash scripts/npm-hardening-check.sh",
    "check:native-contracts": "node scripts/check-native-command-contracts.mjs",
    "check:layer-boundary": "node scripts/check-layer-dependency-boundary.mjs",
    "check:pre-commit": "node scripts/pre-commit-validation.mjs",
    "check:affected": "node scripts/pre-push-affected-validation.mjs",
    "check:settings-classification": "node scripts/check-settings-classification.mjs",
    "check:reading-typography": "node scripts/check-reading-typography-tokens.mjs",
    "copy:guard": "node scripts/check-ui-copy-guard.mjs",
    "copy:guard:strict": "node scripts/check-ui-copy-guard.mjs --strict",
    "lint:desktop": "bash scripts/lint-changed.sh --scope desktop",
    "lint:desktop:full": "eslint --cache --cache-location .tmp/eslint-cache/desktop/ src/app src/features src/shared/ui src/shared/platform electron scripts/windows vite.config.ts playwright.desktop.config.ts",
    "lint:android": "bash scripts/lint-changed.sh --scope android",
    "lint:android:full": "eslint --cache --cache-location .tmp/eslint-cache/android/ src/companion src/shared/platform src/shared/ui src/shared/lib src/shared/commands src/shared/config capacitor.config.ts vite.companion.config.ts",
    "lint:shared": "bash scripts/lint-changed.sh --scope shared",
    "lint:shared:full": "eslint --cache --cache-location .tmp/eslint-cache/shared/ src/shared src/features src/store scripts/check-layer-dependency-boundary.mjs scripts/check-layer-dependency-boundary.test.mjs scripts/check-layer-dependency-boundary.runtime-exports.test.mjs scripts/check-layer-dependency-boundary.topology.test.mjs scripts/check-layer-dependency-boundary.workspace-layout.test.mjs scripts/layer-topology-inspector.mjs scripts/layer-topology-rules.mjs scripts/check-native-command-contracts.mjs scripts/check-native-command-contracts.test.mjs scripts/check-settings-classification.mjs scripts/check-settings-classification.test.mjs scripts/check-reading-typography-tokens.mjs scripts/lint-changed.test.mjs scripts/quality-gate-target.test.mjs scripts/quality-gate-fast.test.mjs scripts/quality-gate-skip-lint-integration.test.mjs scripts/quality-skip-lint.mjs scripts/quality-skip-lint.test.mjs scripts/vite-config.test.mjs vite.config.ts vite.companion.config.ts playwright.desktop.config.ts capacitor.config.ts",
    "typecheck:shared": "tsc -p tsconfig.shared.json --noEmit",
    "typecheck:desktop": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "typecheck:android": "tsc -p tsconfig.android.json --noEmit",
    "test:desktop": "vitest run --reporter=dot --silent=passed-only --pool=threads --maxWorkers=2 src/app src/features src/shared/platform src/shared/ui electron scripts/windows",
    "test:android": "vitest run --reporter=dot --silent=passed-only --pool=threads --maxWorkers=2 src/companion src/shared/platform src/shared/ui src/shared/lib src/shared/commands scripts/android",
    "test:shared": "vitest run --reporter=dot --silent=passed-only --pool=threads --maxWorkers=2 src/shared src/features src/store scripts/check-settings-classification.test.mjs scripts/lint-changed.test.mjs scripts/vite-config.test.mjs",
    "test:quality": "vitest run --reporter=dot --silent=passed-only --pool=threads --maxWorkers=2 scripts/quality-gate-lib.test.mjs scripts/quality-gate-target.test.mjs scripts/quality-gate-fast.test.mjs scripts/quality-gate-fast-lib-routing.test.mjs scripts/quality-gate-skip-lint-integration.test.mjs scripts/quality-skip-lint.test.mjs scripts/pre-commit-validation.test.mjs scripts/pre-push-affected-validation.test.mjs",
    "test:sync-pack": "vitest run --reporter=dot --silent=passed-only --pool=threads --maxWorkers=2 lib/core/sync/syncPackManifest.test.ts electron/database/syncPackManifest.test.ts electron/database/syncPackBuilder.test.ts electron/database/syncPackBuilder.genericObjects.test.ts electron/database/syncPackBuilder.contract.test.ts electron/database/syncPackRows.test.ts electron/database/syncPackExternalDocumentTombstoneScenario.test.ts electron/sync/syncPackApplyStatements.test.ts electron/sync/syncPackNodeApplyExecutor.test.ts electron/sync/syncPackStateRowsExecutor.test.ts electron/sync/syncPackSyncObjectsExecutor.test.ts electron/sync/syncPackContentBlobsExecutor.test.ts electron/sync/syncPackExternalDocumentsExecutor.test.ts electron/sync/syncPackAttachmentObjectsExecutor.test.ts electron/sync/syncPackReviewLogExecutor.test.ts electron/sync/syncPackViewStateObjectsExecutor.test.ts electron/sync/syncPackLearningObjectsExecutor.test.ts electron/sync/syncPackPushAcksExecutor.test.ts src/shared/platform/companionSyncPackApply.test.ts",
    "test:full": "vitest run --reporter=dot --silent=passed-only --pool=threads --maxWorkers=2",
    "test:changed": "vitest run --reporter=dot --silent=passed-only --pool=threads --maxWorkers=2 --changed HEAD",
    "check:android-boundary": "vitest run --reporter=dot --silent=passed-only --pool=threads --maxWorkers=2 scripts/android/java-adapter-boundary.test.mjs scripts/android/java-sql-surface.test.mjs scripts/android/schema-inventory.test.mjs scripts/android/android-sync-*.test.mjs src/shared/platform/companionSqlBoundary.test.ts src/shared/platform/companionSyncWriterQueue.test.ts",
    "windows:preview": "node scripts/preview-dedupe.mjs windows -- bash scripts/windows/windows-preview.sh",
    "desktop:spike:electron": "node scripts/windows/playwright-electron-spike.mjs",
    "desktop:inspect:renders": "WINDOWS_DESKTOP_TEST_SKIP_BUILD=1 WINDOWS_DESKTOP_TEST_CONFIG=playwright.render-diagnostics.config.ts bash scripts/windows/windows-desktop-test.sh",
    "desktop:test:windows": "bash scripts/windows/windows-desktop-test.sh",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "electron:dev": "node scripts/electron-dev.mjs",
    "dev:screenshot": "bash scripts/windows/dev-screenshot.sh",
    "electron:build": "npm run build && npm run electron:compile && electron-builder --config electron/builder.json",
    "oneoff:workspace:migrate": "node scripts/migrate-workspace-data.mjs",
    "oneoff:workspace:backfill-opening-text": "node --experimental-strip-types scripts/backfill-node-opening-text.ts",
    "sqlite:backup": "node --experimental-strip-types scripts/sqlite-maintenance.ts backup",
    "sqlite:restore": "node --experimental-strip-types scripts/sqlite-maintenance.ts restore",
    "oneoff:sqlite:node-kind-report": "node --experimental-strip-types scripts/node-kind-report.ts",
    "android:web:dev": "vite --config vite.companion.config.ts",
    "android:schema:generate": "node scripts/android/generate-companion-schema.mjs",
    "android:web:build": "npm run android:schema:generate && vite build --config vite.companion.config.ts",
    "android:open": "bash scripts/android/windows-open.sh",
    "android:sync": "bash scripts/android/windows-cap-sync.sh",
    "android:reset-sync-data": "node scripts/android/android-reset-sync-data.mjs",
    "android:host:lint": "bash scripts/android/windows-gradle-check.sh lint",
    "android:host:test": "bash scripts/android/windows-gradle-check.sh testDebugUnitTest",
    "android:host:device-test": "bash scripts/android/windows-gradle-check.sh connectedDebugAndroidTest",
    "android:host:device-test:class": "bash scripts/android/windows-gradle-check.sh connectedDebugAndroidTest --class",
    "android:emulator": "bash scripts/android/windows-run-emulator.sh",
    "android:logcat": "bash scripts/android/windows-logcat.sh",
    "android:preview": "node scripts/preview-dedupe.mjs android -- bash scripts/android/android-preview.sh",
    "android:preview:lite": "bash scripts/android/android-preview-lite.sh",
    "android:screenshot": "bash scripts/android/windows-screenshot.sh",
    "android:sync:audit": "node scripts/android/android-sync-audit.mjs",
    "android:sync:scenario": "node scripts/android/android-sync-scenario-sampler.mjs",
    "agent:codex": "bash scripts/codex/run-task.sh",
    "agent:codex:dry-run": "bash scripts/codex/run-task.sh --dry-run",
    "agent:loop": "bash scripts/codex/run-loop.sh",
    "agent:loop:dry-run": "bash scripts/codex/run-loop.sh --dry-run",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "prepare": "npm run hooks:install",
    "task:finish": "node scripts/task-finish.mjs",
    "quality:fast": "bash scripts/quality-gate-fast.sh",
    "quality:desktop": "bash scripts/quality-gate-target.sh desktop",
    "quality:android": "bash scripts/quality-gate-target.sh android",
    "quality:android:device": "bash scripts/quality-gate-target.sh android-device",
    "quality:shared": "bash scripts/quality-gate-target.sh shared",
    "quality:full": "bash scripts/quality-gate-target.sh full",
    "quality:release": "bash scripts/quality-gate-target.sh release",
    "quality:route": "bash scripts/quality-gate-fast.sh --route",
    "lint": "bash scripts/lint-changed.sh",
    "lint:full": "eslint --cache --cache-location .tmp/eslint-cache/full/ .",
    "typecheck": "npm run typecheck:desktop",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "check:ios-boundary": "npm run sync:sql-surface:scan && npm run ios:sqlite-capability:gate",
    "quality:ios": "npm run check:ios-boundary",
    "ios:sync:preflight": "npm run check:ios-boundary",
    "ios:sqlite-capability:gate": "node scripts/sync/ios-capacitor-sqlite-capability-gate.mjs",
    "sync:sql-surface:scan": "node scripts/sync/sql-surface-scan.mjs"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "8.1.0",
    "@capacitor/app": "8.1.0",
    "@capacitor/core": "8.3.0",
    "@capacitor/local-notifications": "8.0.1",
    "@codemirror/commands": "^6.10.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.15",
    "@lezer/markdown": "1.6.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-tooltip": "^1.2.8",
    "better-sqlite3": "12.9.0",
    "bonjour-service": "1.3.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^0.575.0",
    "parse5": "7.3.0",
    "pdfjs-dist": "5.4.296",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-pdf": "10.4.1",
    "tailwind-merge": "^3.5.0",
    "ts-fsrs": "^4.3.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@capacitor/android": "8.3.0",
    "@capacitor/cli": "8.3.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "4.2.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.3.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "@vitejs/plugin-react": "6.0.1",
    "autoprefixer": "^10.5.0",
    "electron": "41.2.1",
    "electron-builder": "26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^15.15.0",
    "jsdom": "^26.0.0",
    "knip": "6.2.0",
    "playwright": "1.59.1",
    "postcss": "8.5.10",
    "prettier": "^3.8.3",
    "tailwindcss": "4.2.2",
    "typescript": "^5.7.3",
    "vite": "8.0.8",
    "vitest": "4.1.5"
  }
}
