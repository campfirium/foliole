{
  "name": "foliole",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "windows:env:check": "bash scripts/windows/windows-env-check.sh",
    "windows:pipeline": "bash scripts/windows/windows-sync-build-test.sh",
    "windows:pipeline:fast": "bash scripts/windows/windows-sync-build-test.sh --skip-tauri-build",
    "windows:package": "bash scripts/windows/windows-sync-build-test.sh --with-tauri-build",
    "windows:dev:native": "bash scripts/windows/windows-sync-launch-native-dev.sh apply",
    "windows:dev:start": "bash scripts/windows/windows-sync-launch-native-dev.sh start",
    "windows:dev:sync": "bash scripts/windows/windows-sync-launch-native-dev.sh sync",
    "windows:dev:restart": "bash scripts/windows/windows-sync-launch-native-dev.sh restart",
    "windows:dev:stop": "bash scripts/windows/windows-sync-launch-native-dev.sh stop",
    "windows:dev:status": "bash scripts/windows/windows-sync-launch-native-dev.sh status",
    "tauri:dev": "tauri dev",
    "tauri:dev:wslg": "GDK_BACKEND=x11 WEBKIT_DISABLE_DMABUF_RENDERER=1 GDK_SCALE=1 GDK_DPI_SCALE=0.5 XCURSOR_THEME=Adwaita XCURSOR_SIZE=16 tauri dev",
    "tauri:build": "tauri build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "windows:dev:check": "bash scripts/windows/windows-check-native-ui.sh"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/themes": "^3.3.0",
    "@tauri-apps/api": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.58.2",
    "@tauri-apps/cli": "^2.10.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.21.0",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^15.15.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.6",
    "prettier": "^3.5.2",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.8"
  }
}
