{
  "name": "foliole",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.12.0",
  "type": "module",
  "main": "electron-dist/electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deps:scan": "knip --dependencies --reporter compact",
    "deps:hardening:check": "bash scripts/npm-hardening-check.sh",
    "windows:preview": "bash scripts/windows/windows-preview.sh",
    "desktop:spike:electron": "node scripts/windows/playwright-electron-spike.mjs",
    "desktop:inspect:renders": "WINDOWS_DESKTOP_TEST_SKIP_BUILD=1 WINDOWS_DESKTOP_TEST_CONFIG=playwright.render-diagnostics.config.ts bash scripts/windows/windows-desktop-test.sh",
    "desktop:test:windows": "bash scripts/windows/windows-desktop-test.sh",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:build": "npm run build && npm run electron:compile && electron-builder --config electron/builder.json",
    "workspace:migrate": "node scripts/migrate-workspace-data.mjs",
    "workspace:backfill-opening-text": "node --experimental-strip-types scripts/backfill-node-opening-text.ts",
    "sqlite:backup": "node --experimental-strip-types scripts/sqlite-maintenance.ts backup",
    "sqlite:restore": "node --experimental-strip-types scripts/sqlite-maintenance.ts restore",
    "sqlite:node-kind-report": "node --experimental-strip-types scripts/node-kind-report.ts",
    "agent:codex": "bash scripts/codex/run-task.sh",
    "agent:codex:dry-run": "bash scripts/codex/run-task.sh --dry-run",
    "agent:loop": "bash scripts/codex/run-loop.sh",
    "agent:loop:dry-run": "bash scripts/codex/run-loop.sh --dry-run",
    "task:finish": "node scripts/task-finish.mjs",
    "verify:preview": "bash scripts/verify-preview.sh",
    "quality:fast": "bash scripts/quality-gate-fast.sh",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "test": "vitest run --pool=threads --maxWorkers=10",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.15",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-tooltip": "^1.2.8",
    "better-sqlite3": "^12.6.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.575.0",
    "parse5": "7.3.0",
    "pdfjs-dist": "5.4.296",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-pdf": "10.4.1",
    "tailwind-merge": "^3.5.0",
    "ts-fsrs": "^4.3.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.3.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.27",
    "electron": "^37.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.21.0",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^15.15.0",
    "jsdom": "^26.0.0",
    "knip": "6.2.0",
    "playwright": "1.58.2",
    "postcss": "^8.5.6",
    "prettier": "^3.5.2",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.8"
  }
}
