{
  "name": "foliole",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron-dist/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "windows:deliver": "bash scripts/windows/windows-deliver.sh",
    "windows:deliver:restart": "WINDOWS_RESTART_CLIENT_MODE=always bash scripts/windows/windows-deliver.sh",
    "windows:preview": "bash scripts/windows/windows-preview.sh",
    "windows:sync": "bash scripts/windows/windows-sync.sh",
    "windows:restart-client": "bash scripts/windows/windows-restart-client.sh",
    "windows:client:status": "WINDOWS_CLIENT_ACTION=status bash scripts/windows/windows-restart-client.sh",
    "windows:client:start": "WINDOWS_CLIENT_ACTION=start bash scripts/windows/windows-restart-client.sh",
    "windows:client:stop": "WINDOWS_CLIENT_ACTION=stop bash scripts/windows/windows-restart-client.sh",
    "windows:dev:native": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"scripts/windows/run-electron-stable.ps1\"",
    "desktop:dev": "npm run electron:dev",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:build": "npm run build && npm run electron:compile && electron-builder --config electron/builder.json",
    "workspace:migrate": "node scripts/migrate-workspace-data.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/themes": "^3.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.5.0",
    "ts-fsrs": "^4.3.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^25.3.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.21.0",
    "eslint-plugin-import": "^2.31.0",
    "electron": "^37.2.0",
    "electron-builder": "^25.1.8",
    "globals": "^15.15.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.6",
    "prettier": "^3.5.2",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.8"
  }
}
