@@ -0,0 +1,101 @@
+import type { pullRequestSyncAttachmentWindows } from '../../../../lib/core/sync/requestSyncAttachmentPull.js';
+
+import type { NativePreparation } from './native-prepared-window.js';
+
+type Settled = { kind: 'ready'; value: NativePreparation } | { kind: 'failed'; error: unknown };
+type Outcome = Awaited<ReturnType<typeof pullRequestSyncAttachmentWindows>>;
+type Prepared = { key: string; result: Promise<Settled> };
+type Input = {
+  keys: string[]; failed: Set<string>; pendingKeys: Set<string>; shouldYield(): boolean;
+  nextKeys?(): Promise<string[]>;
+  prepare(key: string): Promise<NativePreparation>;
+  pull(key: string, prepared: Promise<NativePreparation>): Promise<Outcome>;
+  attempt(key: string, execute: () => Promise<Outcome>): Promise<void>;
+};
+
+export async function runNativePreparedPulls(input: Input) {
+  const queue: Prepared[] = [];
+  const source = demandSource(input.keys, input.nextKeys);
+  let attempted = false;
+  const prepare = (key: string): Prepared => {
+    record('prepare-start', key);
+    return { key, result: input.prepare(key).then(value => {
+      record('prepare-ready', key);
+      return { kind: 'ready', value };
+    }, (error: unknown) => ({ kind: 'failed', error })) };
+  };
+  const fill = () => {
+    while (queue.length < 2) {
+      if ((attempted || queue.length > 0) && input.shouldYield()) break;
+      const key = source.take();
+      if (key === undefined) break;
+      if (input.failed.has(key)) { input.pendingKeys.add(key); continue; }
+      queue.push(prepare(key));
+    }
+  };
+  try {
+    fill();
+    while (!attempted || !input.shouldYield()) {
+      if (!queue.length) {
+        if (!await source.extend()) break;
+        fill();
+        if (!queue.length) break;
+      }
+      const current = queue.shift()!;
+      attempted = true;
+      try {
+        await input.attempt(current.key, async () => {
+          const ready = await current.result;
+          if (ready.kind === 'failed') throw ready.error;
+          fill();
+          return input.pull(current.key, Promise.resolve(ready.value));
+        });
+      } finally { await dispose(current); }
+      fill();
+    }
+    for (const pending of queue) input.pendingKeys.add(pending.key);
+    for (const key of source.remaining()) input.pendingKeys.add(key);
+  } finally { await Promise.all([source.close(), ...queue.map(dispose)]); }
+}
+
+async function dispose(prepared?: Prepared) {
+  const ready = await prepared?.result;
+  if (ready?.kind === 'ready') await ready.value?.window?.close();
+}
+
+type Page = { kind: 'ready'; keys: string[] } | { kind: 'failed'; error: unknown };
+
+function demandSource(initial: string[], load?: () => Promise<string[]>) {
+  const keys = [...new Set(initial)], seen = new Set(keys);
+  let cursor = 0, exhausted = !load;
+  let page: Page | undefined, loading: Promise<void> | undefined;
+  const merge = () => {
+    if (!page) return;
+    const result = page;
+    page = undefined; loading = undefined;
+    if (result.kind === 'failed') throw result.error;
+    const fresh = result.keys.filter(key => !seen.has(key));
+    for (const key of fresh) { seen.add(key); keys.push(key); }
+    if (!fresh.length) exhausted = true;
+  };
+  return {
+    take() {
+      merge();
+      if (cursor >= keys.length) return undefined;
+      const key = keys[cursor++];
+      if (!exhausted && !loading && load && keys.length - cursor <= 2) {
+        loading = load().then(value => { page = { kind: 'ready', keys: value }; },
+          (error: unknown) => { page = { kind: 'failed', error }; });
+      }
+      return key;
+    },
+    async extend() { await loading; merge(); return cursor < keys.length; },
+    async close() { await loading; },
+    remaining: () => keys.slice(cursor)
+  };
+}
+
+function record(event: string, key: string) {
+  const events: unknown = Reflect.get(globalThis, '__t438PreparationEvents');
+  if (Array.isArray(events)) events.push({ event, key, at: Date.now() });
+}
