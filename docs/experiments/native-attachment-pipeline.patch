index 000000000..334192419
--- /dev/null
+++ b/.lab/prototypes/T438/real-path/native-finalization.ts
@@ -0,0 +1,115 @@
+import { recordFramedSyncResourceAvailability } from '../../../../lib/core/database/framedSyncResourceAvailability.js';
+import { ATTACHMENT_BLOCK_BYTES, type AttachmentBlockFiles, type AttachmentBlockResource as Resource } from '../../../../lib/core/sync/attachmentBlockReceiver.js';
+import { completeAttachmentDemand } from '../../../../lib/core/sync/attachmentDemandQueue.js';
+import type { RequestSyncAttachmentHost } from '../../../../lib/core/sync/requestSyncAttachmentResponse.js';
+import type { RequestSyncExchange } from '../../../../lib/core/sync/requestSyncDatabaseExchange.js';
+import type { RequestSyncDatabaseHost } from '../../../../lib/core/sync/requestSyncObjectEndpoint.js';
+
+export type NativeStagingHost = RequestSyncAttachmentHost & {
+  staging?(): Promise<{ files: AttachmentBlockFiles; database: RequestSyncDatabaseHost; notify(key: string): void }>;
+};
+export type NativeSignalExchange = RequestSyncExchange & { withSignal?(signal: AbortSignal): RequestSyncExchange };
+type State = { offset: number; phase: 'writing' | 'finalizing' | 'complete'; release(): void; lease: Promise<void>; done?: Promise<void> };
+type Context = { files: AttachmentBlockFiles; database: RequestSyncDatabaseHost; signal: AbortSignal; notify(key: string): void;
+  states: Map<string, State>; tasks: Set<Promise<void>>; failure: unknown; abort(error: unknown): void };
+
+export async function createNativeFinalization(host: NativeStagingHost, parent?: AbortSignal) {
+  if (!host.staging) throw new Error('native_staging_port_required');
+  const controller = new AbortController();
+  const cancel = () => controller.abort(parent?.reason);
+  if (parent?.aborted) cancel(); else parent?.addEventListener('abort', cancel, { once: true });
+  const context: Context = { ...await host.staging(), signal: controller.signal, states: new Map(), tasks: new Set(),
+    failure: undefined, abort: error => controller.abort(error) };
+  const wrapped: RequestSyncAttachmentHost = { ...host,
+    status: resource => status(context, host, resource),
+    async needsSlice(shouldYield) {
+      const slice = await host.needsSlice(shouldYield);
+      return { ...slice, keys: slice.keys.filter(key => !context.states.has(key) || context.states.get(key)?.phase === 'writing') };
+    },
+    receiveWindow: (resource, offset, execute) => receiveWindow(context, resource, offset, execute)
+  };
+  return { host: wrapped, signal: controller.signal, async close(error?: unknown) {
+    if (error) controller.abort(error);
+    await Promise.all(context.tasks);
+    for (const state of context.states.values()) state.release();
+    await Promise.all([...context.states.values()].map(state => state.lease));
+    parent?.removeEventListener('abort', cancel);
+    if (context.failure) throw context.failure;
+  } };
+}
+
+async function status(context: Context, host: RequestSyncAttachmentHost, resource: Resource) {
+  const existing = context.states.get(resource.storageKey);
+  if (existing) {
+    await existing.done;
+    context.signal.throwIfAborted();
+    return { kind: existing.phase === 'complete' ? 'complete' as const : 'partial' as const, offset: existing.offset };
+  }
+  context.signal.throwIfAborted();
+  const current = await host.status(resource);
+  if (current.kind === 'complete') return current;
+  const held = gate(), acquired = gate();
+  const hash = resource.storageKey.slice(0, 64);
+  const lease = context.files.exclusive(hash, async () => { acquired.resolve(); await held.promise; });
+  await Promise.race([acquired.promise, lease]);
+  if (await context.files.partialLength(hash) !== current.offset) {
+    held.resolve(); await lease; throw new Error('native_pipeline_partial_changed');
+  }
+  context.states.set(resource.storageKey, { offset: current.offset, phase: 'writing', release: held.resolve, lease });
+  return current;
+}
+
+async function receiveWindow(context: Context, resource: Resource, offset: number,
+  execute: Parameters<NonNullable<RequestSyncAttachmentHost['receiveWindow']>>[2]) {
+  while (context.tasks.size >= 2) { record('finalize-backpressure', resource.storageKey); await Promise.race(context.tasks); }
+  context.signal.throwIfAborted();
+  const state = context.states.get(resource.storageKey);
+  if (!state || state.phase !== 'writing' || state.offset !== offset) throw new Error('native_pipeline_owner_changed');
+  const result = await execute();
+  const expected = Math.min(resource.byteLength, offset + result.blocks * ATTACHMENT_BLOCK_BYTES);
+  if (!Number.isInteger(result.blocks) || result.blocks < 0 || result.blocks > 64 || result.offset !== expected ||
+    (!result.blocks && !result.pending && result.offset !== resource.byteLength) ||
+    await context.files.partialLength(resource.storageKey.slice(0, 64)) !== result.offset) throw new Error('attachment_window_result_invalid');
+  state.offset = result.offset;
+  if (result.offset === resource.byteLength) seal(context, state, resource);
+  return result;
+}
+
+function seal(context: Context, state: State, resource: Resource) {
+  state.phase = 'finalizing';
+  record('file-sealed', resource.storageKey);
+  const task = finish(context, resource).then(() => { state.phase = 'complete'; }, (error: unknown) => {
+    context.failure ??= error; context.abort(error);
+  }).finally(() => { state.release(); context.tasks.delete(task); });
+  state.done = task;
+  context.tasks.add(task);
+}
+
+async function finish(context: Context, resource: Resource) {
+  const hash = resource.storageKey.slice(0, 64);
+  context.signal.throwIfAborted();
+  record('hash-start', resource.storageKey);
+  if (!await context.files.verifyPartial(hash)) {
+    await context.files.discardPartial(hash); throw new Error('attachment_checksum_mismatch');
+  }
+  record('hash-finish', resource.storageKey);
+  context.signal.throwIfAborted();
+  await context.files.publish(resource);
+  context.signal.throwIfAborted();
+  await context.database.write(db => db.transaction(async tx => {
+    await recordFramedSyncResourceAvailability(tx, [hash], true);
+    await completeAttachmentDemand(tx, resource.storageKey);
+  }));
+  context.notify(resource.storageKey);
+  record('sqlite-committed', resource.storageKey);
+}
+
+function gate() {
+  let resolve = () => {};
+  const promise = new Promise<void>(done => { resolve = done; });
+  return { resolve, promise };
+}
+function record(event: string, key: string) {
+  const events: unknown = Reflect.get(globalThis, '__t438PreparationEvents');
+  if (Array.isArray(events)) events.push({ event, key, at: Date.now() });
+}
