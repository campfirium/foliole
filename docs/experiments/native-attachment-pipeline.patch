@@ -0,0 +1,37 @@
+import { z } from 'zod';
+
+import { requeueMissingAttachmentArticles } from '../../../../lib/core/sync/attachmentDemandQueue';
+import { companionFramedFileOwner } from '../../../../src/shared/platform/companion/runtime/companionFramedPayloadBudget';
+import { getIosCompanionDatabaseOwner } from '../../../../src/shared/platform/companion/runtime/iosCompanionDatabaseBootstrap';
+import { runCompanionSyncWriterTask } from '../../../../src/shared/platform/companionSyncWriterQueue';
+import { FolioleCompanionSync } from '../../../../src/shared/platform/companionWorkspaceRuntimeRepository';
+
+export async function auditNativeFiles(files: { key: string; bytes: number }[]) {
+  const database = getIosCompanionDatabaseOwner();
+  const identity = companionFramedFileOwner(database);
+  const result = [];
+  for (const file of files) {
+    const stat = z.object({ present: z.boolean(), length: z.number() }).parse(
+      await FolioleCompanionSync.accessFramedSyncFile({ ...identity, operation: 'attachment', key: file.key, partial: false, action: 'stat' }));
+    const hash = z.object({ hash: z.string() }).parse(
+      await FolioleCompanionSync.accessFramedSyncFile({ ...identity, operation: 'attachment', key: file.key, partial: false, action: 'hash' }));
+    const rows = await database.readSnapshot(db => db.query<{ available: number }>(
+      'SELECT available FROM framed_sync_resource_availability WHERE hash = ?', [file.key.slice(0, 64)]));
+    result.push({ key: file.key, bytes: stat.length, ready: stat.present && stat.length === file.bytes
+      && hash.hash === file.key.slice(0, 64) && rows[0]?.available === 1 });
+  }
+  if (result.some(file => !file.ready)) throw new Error('native_file_audit_failed');
+  return { files: result, bytes: result.reduce((sum, file) => sum + file.bytes, 0) };
+}
+
+// Fixed experiment input only; originals remain on the source. This is outside transfer timing.
+export async function resetNativeExperimentCopies(files: { key: string; bytes: number }[]) {
+  await auditNativeFiles(files);
+  for (const file of files) {
+    await FolioleCompanionSync.maintainAttachmentFiles({ operation: 'move', storageKey: file.key, trash: true });
+    await FolioleCompanionSync.maintainAttachmentFiles({ operation: 'remove-trash', storageKey: file.key });
+  }
+  const database = getIosCompanionDatabaseOwner();
+  await runCompanionSyncWriterTask(() => database.runWriter(db => requeueMissingAttachmentArticles(db, files.map(file => file.key))));
+  return { removedExperimentCopies: files.length };
+}
