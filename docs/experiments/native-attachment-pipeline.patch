+// @vitest-environment node
+import { sha256 } from '@noble/hashes/sha2.js';
+import { bytesToHex } from '@noble/hashes/utils.js';
+import { beforeEach, expect, it, vi } from 'vitest';
+
+import { FRAMED_SYNC_PROTOCOL_VERSION } from '../../../../lib/core/sync/framedSyncContract.js';
+import { attachmentRequestSchema } from '../../../../lib/core/sync/requestSyncAttachmentContract.js';
+import type { NativeRequestSyncHttpRequest } from '../../../../lib/platform/nativeRequestSyncHttpContract.js';
+
+const native = vi.hoisted(() => ({ post: vi.fn(), sign: vi.fn(), cancel: vi.fn() }));
+vi.mock('../../../../src/shared/platform/companionWorkspaceRuntimeRepository.js', () => ({ FolioleCompanionSync: {
+  postRequestSyncHttp: native.post, signCompanionSyncRequest: native.sign, cancelRequestSyncHttp: native.cancel
+} }));
+vi.mock('../../../../src/shared/platform/companion/runtime/companionFramedPayloadBudget.js', () => ({
+  companionFramedFileOwner: () => ({ library_key: 'library', generation_id: 'generation' })
+}));
+vi.mock('../../../../src/shared/platform/companion/runtime/iosCompanionDatabaseBootstrap.js', () => ({
+  getIosCompanionDatabaseOwner: () => ({})
+}));
+
+import { prepareCompanionReceive } from './companion-prepared-receive.js';
+
+beforeEach(() => {
+  vi.resetAllMocks();
+  native.sign.mockResolvedValue({ headers: { 'X-Signature': 'native-signature' } });
+});
+
+it.each(['send', 'unused', 'cancelled', 'aged'])('prepares the authenticated native request without posting it: %s', async mode => {
+  const values = new Map<string, Uint8Array>();
