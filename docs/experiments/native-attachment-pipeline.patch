@@ -0,0 +1,106 @@
+/* global document */
+import assert from 'node:assert/strict';
+import fs from 'node:fs/promises';
+import { createRequire } from 'node:module';
+import path from 'node:path';
+import process from 'node:process';
+
+import { createMacosA5ExecutionContext } from '../../../../scripts/android/macos-a5-execution-context.mjs';
+import { assertFixedA5 } from '../../../../scripts/android/macos-a5-dev.mjs';
+import { captured, checked } from '../../../../scripts/android/macos-a5-process.mjs';
+import { acquireMacosA5DeviceLease, releaseMacosA5DeviceLease } from '../../../../scripts/android/macos-a5-run-lease.mjs';
+import { shouldStopAdbServer } from '../../../../scripts/android/macos-a5-run-cleanup.mjs';
+import { macosA5Paths } from '../../../../scripts/android/macos-a5-runtime-paths.mjs';
+import { readA5SyncLogs } from '../../../../scripts/android/macos-a5-sync-logs.mjs';
+import { runT234WebViewSession } from '../../../../scripts/android/macos-a5-t234-webview-session.mjs';
+
+const require = createRequire(import.meta.url);
+const { _android } = require('playwright');
+const label = process.argv[2];
+if (!['baseline', 'prefetch', 'shared-queue', 'split-http', 'finalization', 'receipt-fixed-1', 'receipt-fixed-2', 'pipeline', 'pipeline-2'].includes(label)) {
+  throw new Error('Expected a T438 experiment label.');
+}
+const root = path.resolve('.tmp/artifacts/T438/real-path');
+const context = createMacosA5ExecutionContext({ action: 't234-webview-session', repoRoot: process.cwd() });
+const paths = macosA5Paths(context);
+const lease = acquireMacosA5DeviceLease(context, 'mutation');
+let device, finish, session, page;
+try {
+  let ready, rejectReady;
+  const hold = new Promise(resolve => { finish = resolve; });
+  const readyWait = new Promise((resolve, reject) => { ready = resolve; rejectReady = reject; });
+  session = runT234WebViewSession({ assertFixed: () => assertFixedA5(paths), buildIdentity: () => context.runId,
+    captured, checked: preserveUnownedApplications, paths, serial: '87a33a4b', waitForEnd: () => { ready(); return hold; }
+  }).catch(error => { rejectReady(error); throw error; });
+  await readyWait;
+  const info = JSON.parse(await fs.readFile(path.join(paths.artifactsRoot, 'a5-t234-webview-session', context.runId, 'session.json'), 'utf8'));
+  device = (await _android.devices({ omitDriverInstall: true })).find(item => item.serial() === '87a33a4b');
+  assert.ok(device, 'Fixed A5 is absent');
+  const view = await device.webView({ pkg: info.appId, socketName: info.socket });
+  page = await view.page();
+  await page.waitForFunction(() => !document.querySelector('[data-testid="t438-run"]').disabled, undefined, { timeout: 60000 });
+  await runExperiment(page);
+} catch (error) {
+  const failure = { error: String(error), result: page && !page.isClosed()
+    ? await page.getByTestId('t438-result').inputValue().catch(() => null) : null };
+  await fs.writeFile(path.join(root, `android-${label}-failure.json`), JSON.stringify(failure));
+  try { collectTrace(); } catch { /* Preserve the primary experiment failure. */ }
+  throw error;
+} finally {
+  try { await device?.close(); }
+  finally {
+    finish?.();
+    try { await session; }
+    finally {
+      releaseMacosA5DeviceLease(lease);
+      if (shouldStopAdbServer()) checked(paths.adb, ['kill-server']);
+    }
+  }
+}
+
+function preserveUnownedApplications(command, args, options) {
+  if (args.includes('com.campfirium.foliole.android/com.foliole.android.MainActivity')) return;
+  // This session uses omitDriverInstall and owns no driver package to uninstall.
+  if (args.some(value => value === 'com.microsoft.playwright.androiddriver' || value === 'com.microsoft.playwright.androiddriver.test')) return;
+  return checked(command, args, options);
+}
+
+async function runExperiment(page) {
+  const reset = await action(page, 'reset');
+  assert.equal(reset.milestones.findLast(row => row.phase.startsWith('reset-')).phase, 'reset-finished');
+  await fs.writeFile(path.join(root, `android-${label}-reset.json`), JSON.stringify(reset));
+  const triggeredAt = Date.now();
+  await page.getByTestId('t438-run').click();
+  await page.waitForFunction(start => JSON.parse(document.querySelector('[data-testid="t438-result"]').value)
+    .milestones.some(row => row.at >= start && ['finished', 'failed'].includes(row.phase)), triggeredAt, { timeout: 240000 });
+  const result = JSON.parse(await page.getByTestId('t438-result').inputValue());
+  await fs.writeFile(path.join(root, `android-native-${label}.json`), JSON.stringify({ triggeredAt, ...result }));
+  collectTrace();
+  assert.equal(result.milestones.findLast(row => row.phase === 'finished')?.detail.outcome, 'completed');
+  assert.ok(result.native.some(row => row.at >= triggeredAt && row.method === 'postRequestSyncHttp' && row.attachment));
+  const audit = await action(page, 'audit');
+  await fs.writeFile(path.join(root, `android-native-${label}-audit.json`), JSON.stringify(audit));
+  const proof = audit.milestones.findLast(row => row.phase.startsWith('audit-'));
+  assert.equal(proof.phase, 'audit-passed');
+  assert.equal(proof.detail.files.length, 196);
+  assert.equal(proof.detail.bytes, 100073172);
+  process.stdout.write(JSON.stringify({ label, outcome: 'completed', files: 196, bytes: proof.detail.bytes }) + '\n');
+}
+
+async function action(page, name) {
+  const started = Date.now();
+  await page.getByTestId(`t438-${name}`).click();
+  await page.waitForFunction(({ name, started }) => JSON.parse(document.querySelector('[data-testid="t438-result"]').value)
+    .milestones.some(row => row.at >= started && row.phase.startsWith(name + '-')), { name, started }, { timeout: 60000 });
+  return JSON.parse(await page.getByTestId('t438-result').inputValue());
+}
+
+function collectTrace() {
+  readA5SyncLogs({ assertFixed: () => assertFixedA5(paths), buildIdentity: () => context.runId,
+    captured: (command, args, options) => {
+      const raw = captured(command, [...args.filter(value => value !== 'Capacitor/Console:I')
+        .map(value => value === 'FolioleSyncHttp:D' ? 'T438NativeQueue:I' : value), 'T438NativeFile:I'], options);
+      require('node:fs').writeFileSync(path.join(root, `native-${label}.log`), raw);
+      return raw;
+    }, paths, serial: '87a33a4b' });
+}
diff --git a/.lab/prototypes/T438/real-path/native-finalization.ts b/.lab/prototypes/T438/real-path/native-finalization.ts
