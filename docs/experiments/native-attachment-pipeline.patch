+    write: async (key: string, bytes: Uint8Array) => { values.set(key, bytes.slice()); },
+    remove: async (key: string) => { for (const name of values.keys()) if (name.startsWith(key)) values.delete(name); }
+  };
+  const signal = new AbortController();
+  const query = attachmentRequestSchema.parse({ operation: 'pull', requestId: new Uint8Array(16).fill(3),
+    storageKey: `${'a'.repeat(64)}.png`, byteLength: 321 });
+  native.post.mockImplementation(async (request: NativeRequestSyncHttpRequest) => {
+    const body = Buffer.concat(Array.from({ length: request.request_chunk_count }, (_, index) =>
+      Buffer.from(values.get(`${request.directory}/http-out-${index}`)!)));
+    expect(native.sign.mock.calls[0]![0].body_hash).toBe(bytesToHex(sha256(body)));
+    expect(request.headers['X-Signature']).toBe('native-signature');
