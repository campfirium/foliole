+    const { loadOrCreateDesktopDeviceId } = await load('database/deviceIdentity.js');
+    const { ensureLanWorkspaceSyncServer, stopLanWorkspaceSyncServer } = await load('sync/lanWorkspaceSyncServer.js');
+    const { handleInvokeRequest } = await load('ipc/commands.js');
+    initializeDatabase(undefined, { deferSearchIndex: true });
+    markDatabaseReady();
+    const invoke = (command, args = {}) => handleInvokeRequest({ command, args });
+    const input = JSON.parse(await fs.readFile(path.join(root, 'performance-volume-100mb.json'), 'utf8'));
+    const stamp = new Date().toISOString();
+    const reuse = process.argv.includes('--reuse-input');
+    const nodeId = reuse ? JSON.parse(await fs.readFile(path.join(root, 'source-shell-ready.json'), 'utf8')).nodeId
+      : `t438-native-${randomUUID()}`;
