@@ -0,0 +1,65 @@
+import { createHash } from 'node:crypto';
+import fs from 'node:fs/promises';
+import path from 'node:path';
+
+export async function stageNativeTrace(root, split) {
+  const changed = [];
+  async function write(relative, source) {
+    await fs.writeFile(path.join(root, relative), source);
+    changed.push({ path: relative, sha256: createHash('sha256').update(source).digest('hex') });
+  }
+  const java = 'android/app/src/main/java/com/foliole/android/';
+  const relative = java + 'FolioleCompanionRequestSyncHttp.java';
+  let source = await fs.readFile(path.join(root, relative), 'utf8');
+  const begin = '            try { executor.execute(() -> {\n';
+  const end = '                finally { ACTIVE.remove(id, operation); }\n            });';
+  if (!source.includes(begin) || !source.includes(end)) throw new Error('native_http_executor_entry_changed');
+  source = source.replace(begin, `            String role = call.getObject("attachment_receive") == null ? "control" : "receive";
+            android.util.Log.i("T438NativeQueue", "id=" + id + " role=" + role + " phase=queued at=" + System.currentTimeMillis());
+            try { executor.execute(() -> {
+                android.util.Log.i("T438NativeQueue", "id=" + id + " role=" + role + " phase=start at=" + System.currentTimeMillis());
+`);
+  source = source.replace(end, `                finally {
+                    android.util.Log.i("T438NativeQueue", "id=" + id + " role=" + role + " phase=finish at=" + System.currentTimeMillis());
+                    ACTIVE.remove(id, operation);
+                }
+            });`);
+  await write(relative, source);
+  await traceFiles(root, java, write);
+  if (split) {
+    const plugin = java + 'FolioleCompanionSyncPlugin.java';
+    let code = await fs.readFile(path.join(root, plugin), 'utf8');
+    const declaration = '    private final ExecutorService framedSendExecutor = Executors.newSingleThreadExecutor();';
+    const call = 'FolioleCompanionRequestSyncHttp.post(getContext(), call, framedSendExecutor);';
+    if (!code.includes(declaration) || !code.includes(call)) throw new Error('native_plugin_executor_entry_changed');
+    code = code.replace(declaration, declaration + '\n    private final ExecutorService attachmentReceiveExecutor = Executors.newSingleThreadExecutor();');
+    code = code.replace(call, 'FolioleCompanionRequestSyncHttp.post(getContext(), call,\n            call.getObject("attachment_receive") == null ? framedSendExecutor : attachmentReceiveExecutor);');
+    code = code.replace('framedSendExecutor.shutdown();', 'framedSendExecutor.shutdown();\n        attachmentReceiveExecutor.shutdown();');
+    await write(plugin, code);
+  }
+  return changed;
+}
+
+async function traceFiles(root, java, write) {
+  const blockPath = java + 'FolioleAttachmentBlockFiles.java';
+  let blocks = await fs.readFile(path.join(root, blockPath), 'utf8');
+  const entry = '    private JSObject execute(PluginCall call) throws Exception {';
+  if (!blocks.includes(entry)) throw new Error('native_file_trace_entry_changed');
+  blocks = blocks.replace(entry, `    private JSObject execute(PluginCall call) throws Exception {
+        String action = call.getString("action", ""), key = call.getString("key", "");
+        if (!action.equals("hash") && !action.equals("publish")) return executeObserved(call);
+        android.util.Log.i("T438NativeFile", "key=" + key + " action=" + action + " phase=start at=" + System.currentTimeMillis());
+        try { return executeObserved(call); }
+        finally { android.util.Log.i("T438NativeFile", "key=" + key + " action=" + action + " phase=finish at=" + System.currentTimeMillis()); }
+    }
+    private JSObject executeObserved(PluginCall call) throws Exception {`);
+  await write(blockPath, blocks);
+  const receivePath = java + 'FolioleAttachmentReceiveFile.java';
+  let receive = await fs.readFile(path.join(root, receivePath), 'utf8');
+  receive = receive.replace('    private final RandomAccessFile file;', '    private final RandomAccessFile file;\n    private final String traceKey;');
+  receive = receive.replace('        this.owner = owner;', '        this.traceKey = path.getName();\n        this.owner = owner;');
+  receive = receive.replace('            file.write(bytes);', `            android.util.Log.i("T438NativeFile", "key=" + traceKey + " action=append phase=start at=" + System.currentTimeMillis());
+            file.write(bytes);
+            android.util.Log.i("T438NativeFile", "key=" + traceKey + " action=append phase=finish at=" + System.currentTimeMillis() + " bytes=" + bytes.length);`);
+  await write(receivePath, receive);
+}
