+/* global AbortController */
+import assert from 'node:assert/strict';
+import { getEventListeners } from 'node:events';
+import test from 'node:test';
+
+import { waitForNativeDispatch } from './native-prepared-window.ts';
+import { runNativePreparedPulls } from './native-request-prefetch.ts';
+
+function gate() {
+  let resolve;
+  const promise = new Promise(done => { resolve = done; });
+  return { promise, resolve };
+}
+
+test('the first two items prepare together and prepared items send consecutively in order', async () => {
+  const keys = ['a', 'b', 'c', 'd'];
+  const preparations = new Map(keys.map(key => [key, gate()]));
+  const transmissions = new Map(keys.map(key => [key, gate()]));
+  const dispatched = new Map(keys.map(key => [key, gate()]));
+  const started = [], sent = [], closed = [];
+  let active = 0;
+  const operation = runNativePreparedPulls({ keys, failed: new Set(), pendingKeys: new Set(), shouldYield: () => false,
+    async prepare(key) {
+      started.push(key);
+      await preparations.get(key).promise;
+      return { resource: { storageKey: key, byteLength: 1 }, initial: { kind: 'partial', offset: 0 },
+        window: { async send() {}, async close() { closed.push(key); } } };
+    },
+    async pull(key, prepared) {
+      await prepared;
+      assert.equal(active++, 0, 'only one transfer may own the send path');
+      sent.push(key);
+      dispatched.get(key).resolve();
+      await transmissions.get(key).promise;
+      active--;
+      return { complete: true, blocks: 1 };
+    },
+    async attempt(_key, execute) { await execute(); }
+  });
+  try {
+    assert.deepEqual(started, ['a', 'b'], 'second preparation must start while the first is still preparing');
+    preparations.get('b').resolve();
+    assert.deepEqual(sent, []);
+    preparations.get('a').resolve();
+    await dispatched.get('a').promise;
+    assert.deepEqual(started, ['a', 'b', 'c'], 'two preparation slots continue working while one item sends');
+    preparations.get('c').resolve();
+    transmissions.get('a').resolve();
+    await dispatched.get('b').promise;
+    assert.deepEqual(started, ['a', 'b', 'c', 'd']);
+    preparations.get('d').resolve();
+    transmissions.get('b').resolve();
+    await dispatched.get('c').promise;
+    transmissions.get('c').resolve();
+    await dispatched.get('d').promise;
+    assert.deepEqual(sent, keys);
+  } finally {
+    for (const item of preparations.values()) item.resolve();
+    for (const item of transmissions.values()) item.resolve();
+    await operation;
+  }
+  assert.deepEqual(closed, keys);
+});
+
+test('preparation is ready without sending until the dispatch is granted', async () => {
+  const dispatch = gate();
+  const events = [];
+  const pending = waitForNativeDispatch({ ready: () => events.push('ready'), dispatch: dispatch.promise })
+    .then(() => events.push('sent'));
+  await Promise.resolve();
+  assert.deepEqual(events, ['ready']);
+  dispatch.resolve();
+  await pending;
+  assert.deepEqual(events, ['ready', 'sent']);
+});
+
+test('canceling an unsent request releases the dispatch wait and listener', async () => {
+  const controller = new AbortController();
+  const pending = waitForNativeDispatch({ ready() {}, dispatch: gate().promise }, controller.signal);
+  controller.abort(new Error('cancelled'));
+  await assert.rejects(pending, /cancelled/u);
+  assert.equal(getEventListeners(controller.signal, 'abort').length, 0);
+});
+
+test('a request cancelled before preparation cannot become ready', async () => {
+  const controller = new AbortController();
+  controller.abort(new Error('cancelled'));
+  await assert.rejects(waitForNativeDispatch({ ready() { assert.fail('ready after cancellation'); },
+    dispatch: gate().promise }, controller.signal), /cancelled/u);
+});
+
+test('yielding after a file closes the unused lookahead and keeps it pending', async () => {
+  let yielded = false;
+  const closed = [], pending = new Set(), pulled = [];
+  await runNativePreparedPulls({ keys: ['a', 'b', 'c'], failed: new Set(), pendingKeys: pending, shouldYield: () => yielded,
+    async prepare(key) { return { resource: { storageKey: key, byteLength: 1 }, initial: { kind: 'partial', offset: 0 },
+      window: { async send() { assert.fail('transport is owned by pull'); }, async close() { closed.push(key); } } }; },
+    async pull(key) { pulled.push(key); yielded = true; return { complete: true, blocks: 1 }; },
+    async attempt(_key, execute) { await execute(); } });
+  assert.deepEqual(pulled, ['a']);
+  assert.deepEqual(closed.sort(), ['a', 'b', 'c']);
+  assert.deepEqual([...pending], ['b', 'c']);
+});
+
+test('the next demand slice prepares before the previous slice finishes sending', async () => {
+  const entered = gate(), release = gate();
+  const started = [], sent = [];
+  let calls = 0;
+  const operation = runNativePreparedPulls({ keys: ['a', 'b'], failed: new Set(), pendingKeys: new Set(),
+    shouldYield: () => false,
+    async nextKeys() { calls++; return calls === 1 ? ['a', 'b', 'c', 'd'] : []; },
+    async prepare(key) {
+      started.push(key);
+      return { resource: { storageKey: key, byteLength: 1 }, initial: { kind: 'partial', offset: 0 } };
+    },
+    async pull(key) {
+      sent.push(key);
+      if (key === 'b') { entered.resolve(); await release.promise; }
+      return { complete: true, blocks: 1 };
+    },
+    async attempt(_key, execute) { await execute(); }
+  });
+  try {
+    await entered.promise;
+    assert.deepEqual(started, ['a', 'b', 'c', 'd']);
+    assert.deepEqual(sent, ['a', 'b']);
+  } finally { release.resolve(); await operation; }
+  assert.deepEqual(sent, ['a', 'b', 'c', 'd']);
+});
+
+test('a rejected attempt closes its prepared request without dispatching it', async () => {
+  let closed = 0;
+  await runNativePreparedPulls({ keys: ['a'], failed: new Set(), pendingKeys: new Set(), shouldYield: () => false,
+    async prepare() { return { resource: { storageKey: 'a', byteLength: 1 }, initial: { kind: 'partial', offset: 0 },
+      window: { async send() { assert.fail('unexpected dispatch'); }, async close() { closed++; } } }; },
+    async pull() { assert.fail('attempt never entered'); }, async attempt() {} });
+  assert.equal(closed, 1);
+});
