+import { createHash } from 'node:crypto';
+import { execFileSync } from 'node:child_process';
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import process from 'node:process';
+
+import { stageNativePrefetch } from './stage-native-prefetch.mjs';
+import { stageNativeTrace } from './stage-native-trace.mjs';
+import { stageNativeFinalization } from './stage-native-finalization.mjs';
+import { stageNativeRequests } from './stage-native-requests.mjs';
+
+// Freeze the current Android production path without writing into the checkout.
+const repo = process.cwd();
+const fromIndex = process.argv.indexOf('--from');
+const sourceRoot = fromIndex < 0 ? repo : path.resolve(process.argv[fromIndex + 1]);
+const previous = fromIndex < 0 ? null : JSON.parse(await fs.readFile(path.join(sourceRoot, 'experiment-manifest.json'), 'utf8'));
+const separate = process.argv.includes('--separate-app');
+const parent = path.join(repo, '.tmp/artifacts/T438/real-path');
+await fs.mkdir(parent, { recursive: true });
+const root = await fs.mkdtemp(path.join(parent, 'android-baseline-'));
+const listing = previous ? previous.sources.map(source => source.path).join('\0') : execFileSync('git', ['ls-files', '-z', '--cached', '--others', '--exclude-standard',
+  '--', 'src', 'lib', 'scripts', 'electron', 'android', 'assets', 'public',
+  'package.json', 'package-lock.json', 'capacitor.config.ts', 'vite*.ts', 'tsconfig*.json',
+  'tailwind.config.js', 'postcss.config.js'],
+{ cwd: repo, maxBuffer: 16 * 1024 * 1024 }).toString();
+const sources = [];
+for (const relative of [...new Set(listing.split('\0').filter(Boolean))].sort()) {
+  const source = path.join(sourceRoot, relative);
+  const content = await fs.readFile(source);
+  const output = path.join(root, relative);
+  await fs.mkdir(path.dirname(output), { recursive: true });
+  await fs.copyFile(source, output);
+  await fs.chmod(output, (await fs.stat(source)).mode);
+  sources.push({ path: relative, sha256: createHash('sha256').update(content).digest('hex') });
+}
+await fs.symlink(path.join(repo, 'node_modules'), path.join(root, 'node_modules'));
+// Reuse the existing fixed-device exclusion if this capsule is later authorized for deploy.
+const controller = '.lab/internal/macos-a5-controller';
+await fs.mkdir(path.join(root, controller), { recursive: true });
+await fs.symlink(path.join(repo, controller, 'leases'), path.join(root, controller, 'leases'));
+const overrides = [];
+if (process.argv.includes('--shell')) {
+  for (const [name, target] of [['android-shell', 'main.tsx'], ['native-observation', 'native-observation.ts'],
+    ['native-audit', 'native-audit.ts'], ['shell-result-phase', 'shell-result-phase.ts']]) {
+    const original = await fs.readFile(path.join(repo, '.lab/prototypes/T438/real-path', `${name}.ts`), 'utf8');
+    let source = original.replaceAll('../../../../src/', '../').replaceAll('../../../../lib/', '../../lib/');
+    if (name === 'android-shell') {
+      const input = JSON.parse(await fs.readFile(path.join(parent, 'performance-volume-100mb.json'), 'utf8'));
+      source = source.replace('const expected: { key: string; bytes: number }[] = [];',
+        `const expected: { key: string; bytes: number }[] = ${JSON.stringify(input.files.map(({ key, bytes }) => ({ key, bytes })))};`);
+    }
+    const relative = `src/companion/${target}`;
+    await fs.writeFile(path.join(root, relative), source);
+    overrides.push({ path: relative, sha256: createHash('sha256').update(source).digest('hex') });
+  }
+}
+const manifest = {
+  mode: 'android-production-baseline', root, repo,
+  revision: previous?.revision ?? execFileSync('git', ['rev-parse', 'HEAD'], { cwd: repo }).toString().trim(),
+  workspaceStatus: previous?.workspaceStatus ?? execFileSync('git', ['status', '--short'], { cwd: repo }).toString(),
+  sources, overrides,
+  applicationId: separate ? 'com.campfirium.foliole.android.t438' : 'com.campfirium.foliole.android.acceptance',
+  syncPort: separate ? 38646 : 38644, sourceRoot,
+  dependencyRoot: path.join(repo, 'node_modules'),
+  boundary: 'Build input only. No device installation, launch, pairing or sync has run.'
+};
+if (process.argv.includes('--prefetch')) {
+  manifest.mode = 'android-shell-native-prefetch';
+  manifest.overrides.push(...await stageNativePrefetch(repo, root));
+}
+if (process.argv.includes('--native-trace') || process.argv.includes('--split-http')) {
+  manifest.overrides.push(...await stageNativeTrace(root, process.argv.includes('--split-http')));
+  if (process.argv.includes('--split-http')) manifest.mode += '-split-http';
+}
+if (process.argv.includes('--finalization')) {
+  manifest.overrides.push(...await stageNativeFinalization(repo, root));
+  manifest.mode += '-finalization';
+}
+if (process.argv.includes('--prepared-requests')) {
+  manifest.overrides.push(...await stageNativeRequests(repo, root));
+  manifest.mode += '-prepared-requests';
+}
+await fs.writeFile(path.join(root, 'experiment-manifest.json'), JSON.stringify(manifest, null, 2));
+await fs.writeFile(path.join(parent, 'latest-android-baseline.json'), JSON.stringify({ root }, null, 2));
+process.stdout.write(`${root}\n`);
