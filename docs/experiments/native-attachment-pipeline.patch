@@ -0,0 +1,69 @@
+import { createHash } from 'node:crypto';
+import fs from 'node:fs/promises';
+import path from 'node:path';
+
+export async function stageNativeRequests(repo, root) {
+  const changed = [];
+  const core = 'lib/core/sync/';
+  const framed = 'src/shared/platform/companion/sync/framed/';
+  const prototype = path.join(repo, '.lab/prototypes/T438/real-path');
+  async function write(relative, source) {
+    await fs.writeFile(path.join(root, relative), source);
+    changed.push({ path: relative, sha256: createHash('sha256').update(source).digest('hex') });
+  }
+  const window = await fs.readFile(path.join(prototype, 'native-prepared-window.ts'), 'utf8');
+  await write(core + 't438NativePreparedWindow.ts', window.replaceAll('../../../../lib/core/sync/', './'));
+  let prefetch = await fs.readFile(path.join(prototype, 'native-request-prefetch.ts'), 'utf8');
+  prefetch = prefetch.replaceAll('./native-prepared-window.js', './t438NativePreparedWindow.js')
+    .replaceAll('../../../../lib/core/sync/', './');
+  await write(core + 't438NativePrefetch.ts', prefetch);
+  let run = await fs.readFile(path.join(root, core + 'requestSyncAttachmentExchange.ts'), 'utf8');
+  run = run.replace('        shouldYield, attempt,',
+    '        shouldYield, attempt, nextKeys: async () => shouldYield() ? [] : (await host.needsSlice(shouldYield)).keys,');
+  await write(core + 'requestSyncAttachmentExchange.ts', run);
+  let receiver = await fs.readFile(path.join(prototype, 'companion-prepared-receive.ts'), 'utf8');
+  receiver = receiver.replaceAll('../../../../lib/core/', '../../../../../../lib/core/')
+    .replaceAll('../../../../src/shared/platform/companion/sync/framed/', './')
+    .replaceAll('./native-prepared-window.js', '../../../../../../lib/core/sync/t438NativePreparedWindow.js');
+  await write(framed + 't438PreparedReceive.ts', receiver);
+  await wireHttp(root, framed, core, write);
+  let exchange = await fs.readFile(path.join(root, framed + 'companionRequestSyncExchange.ts'), 'utf8');
+  exchange = "import { prepareCompanionReceive } from './t438PreparedReceive.js';\n" + exchange;
+  exchange = exchange.replace('return { withSignal:', 'return { prepareAttachment: query => prepareCompanionReceive(host.files, input, query), withSignal:');
+  exchange = exchange.replace('): NativeSignalExchange {', '): NativeSignalExchange & NativePreparedExchange {');
+  exchange = `import type { NativePreparedExchange } from '../../../../../../lib/core/sync/t438NativePreparedWindow.js';\n` + exchange;
+  await write(framed + 'companionRequestSyncExchange.ts', exchange);
+  let pull = await fs.readFile(path.join(root, core + 'requestSyncAttachmentPull.ts'), 'utf8');
+  pull = "import { prepareNativeWindow, pullPreparedNativeWindows, type NativePreparedExchange, type NativePreparation } from './t438NativePreparedWindow.js';\n" + pull;
+  pull = pull.replace('  const { resource, initial } = ready;', `  const { resource, initial } = ready;
+  if (ready.window) return pullPreparedNativeWindows(host, exchange, ready, shouldYield);`);
+  pull = pull.replace('prepareRequestSyncAttachment(host: RequestSyncAttachmentHost, exchange: RequestSyncExchange,',
+    'prepareRequestSyncAttachment(host: RequestSyncAttachmentHost, exchange: NativePreparedExchange,');
+  pull = pull.replace('  key: string, shouldYield: () => boolean) {',
+    '  key: string, shouldYield: () => boolean): Promise<NativePreparation> {');
+  pull = pull.replace('  return resource ? { resource, initial: await host.status(resource) } : null;', `  if (!resource) return null;
+  const initial = await host.status(resource);
+  const window = initial.kind === 'complete' ? undefined : await prepareNativeWindow(exchange, resource, initial.offset);
+  return { resource, initial, ...(window ? { window } : {}) };`);
+  await write(core + 'requestSyncAttachmentPull.ts', pull);
+  return changed;
+}
+
+async function wireHttp(root, framed, core, write) {
+  let http = await fs.readFile(path.join(root, framed + 'companionRequestSyncHttp.ts'), 'utf8');
+  http = `import { waitForNativeDispatch, type DispatchGate } from '../../../../../../${core}t438NativePreparedWindow.js';\n` + http;
+  http = http.replace('  endpointUrl: string;', '  preparationGate?: DispatchGate;\n  endpointUrl: string;');
+  const dispatch = '    const operation = FolioleCompanionSync.postRequestSyncHttp(request);';
+  if (!http.includes(dispatch)) throw new Error('native_dispatch_entry_changed');
+  http = http.replace('    const signature = await FolioleCompanionSync.signCompanionSyncRequest({',
+    '    const signedAt = Date.now();\n    const sign = () => FolioleCompanionSync.signCompanionSyncRequest({');
+  http = http.replace('    const request: NativeRequestSyncHttpRequest =',
+    '    const signature = await sign();\n    const request: NativeRequestSyncHttpRequest =');
+  http = http.replace(dispatch, `    if (input.preparationGate) await waitForNativeDispatch(input.preparationGate, input.signal);
+    if (Date.now() - signedAt >= 30_000) {
+      Object.assign(request.headers, (await sign()).headers);
+      input.signal?.throwIfAborted();
+    }
+${dispatch}`);
+  await write(framed + 'companionRequestSyncHttp.ts', http);
+}
diff --git a/.lab/prototypes/T438/real-path/stage-native-trace.mjs b/.lab/prototypes/T438/real-path/stage-native-trace.mjs
