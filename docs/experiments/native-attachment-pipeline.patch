@@ -0,0 +1,44 @@
+import { createHash } from 'node:crypto';
+import fs from 'node:fs/promises';
+import path from 'node:path';
+
+export async function stageNativePrefetch(repo, root) {
+  const changed = [];
+  async function write(relative, source) {
+    await fs.writeFile(path.join(root, relative), source);
+    changed.push({ path: relative, sha256: createHash('sha256').update(source).digest('hex') });
+  }
+  const core = 'lib/core/sync/';
+  const helper = await fs.readFile(path.join(repo, '.lab/prototypes/T438/real-path/native-prefetch.ts'), 'utf8');
+  await write(core + 't438NativePrefetch.ts', helper.replaceAll('../../../../lib/core/sync/', './'));
+  let pull = await fs.readFile(path.join(root, core + 'requestSyncAttachmentPull.ts'), 'utf8');
+  const signature = '  storageKey: string, shouldYield: () => boolean) {';
+  const original = `  const resource = await describe(exchange, storageKey, shouldYield);
+  if (!resource) return { complete: false, blocks: 0, verificationPending: true };
+  const initial = await host.status(resource);`;
+  if (!pull.includes(signature) || !pull.includes(original)) throw new Error('native_pull_entry_changed');
+  pull = pull.replace(signature, `  storageKey: string, shouldYield: () => boolean,
+  prepared = prepareRequestSyncAttachment(host, exchange, storageKey, shouldYield)) {`);
+  pull = pull.replace(original, `  const ready = await prepared;
+  if (!ready) return { complete: false, blocks: 0, verificationPending: true };
+  const { resource, initial } = ready;`);
+  pull += `\nexport async function prepareRequestSyncAttachment(host: RequestSyncAttachmentHost, exchange: RequestSyncExchange,
+  key: string, shouldYield: () => boolean) {
+  const resource = await describe(exchange, key, shouldYield);
+  return resource ? { resource, initial: await host.status(resource) } : null;
+}\n`;
+  await write(core + 'requestSyncAttachmentPull.ts', pull);
+  let exchange = await fs.readFile(path.join(root, core + 'requestSyncAttachmentExchange.ts'), 'utf8');
+  if (!exchange.includes('      let attempted = false;')) throw new Error('native_exchange_entry_changed');
+  exchange = "import { runNativePreparedPulls } from './t438NativePrefetch.js';\n" + exchange;
+  exchange = exchange.replace('import { attachmentRequest, pullRequestSyncAttachmentWindows,',
+    'import { attachmentRequest, prepareRequestSyncAttachment, pullRequestSyncAttachmentWindows,');
+  exchange = exchange.replace('      let attempted = false;', `      if (exchange.receiveAttachment) return runNativePreparedPulls({ keys: local.keys, failed, pendingKeys,
+        shouldYield, attempt,
+        prepare: key => prepareRequestSyncAttachment(host, exchange, key, shouldYield),
+        pull: (key, prepared) => pullRequestSyncAttachmentWindows(host, exchange, key, shouldYield, prepared)
+      });
+      let attempted = false;`);
+  await write(core + 'requestSyncAttachmentExchange.ts', exchange);
+  return changed;
+}
