+      initiatorLibraryEpoch: 'local-epoch', responderDeviceId: 'peer', responderLibraryEpoch: 'peer-epoch' },
+    endpointUrl: 'http://127.0.0.1:1' }, query);
+  expect(native.sign).toHaveBeenCalledOnce();
+  expect(native.post).not.toHaveBeenCalled();
+  expect(values.size).toBeGreaterThan(0);
+  if (mode === 'aged') {
+    const now = Date.now();
+    vi.spyOn(Date, 'now').mockReturnValue(now + 31_000);
+    try {
+      await prepared.send();
+      expect(native.sign).toHaveBeenCalledTimes(2);
+      expect(native.sign.mock.calls[1]![0].nonce).not.toBe(native.sign.mock.calls[0]![0].nonce);
+      expect(native.sign.mock.calls[1]![0].body_hash).toBe(native.sign.mock.calls[0]![0].body_hash);
