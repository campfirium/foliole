+import { Capacitor } from '@capacitor/core';
+
+export function observeNativeCalls() {
+  const original: unknown = Reflect.get(Capacitor, 'nativePromise');
+  if (typeof original !== 'function') throw new Error('native_promise_bridge_missing');
+  const events: { id: number; phase: string; at: number; plugin: string; method: string;
+    action?: string; attachment?: boolean; error?: string }[] = [];
+  let next = 0;
+  Reflect.set(Capacitor, 'nativePromise', async function(plugin: string, method: string, options: unknown) {
+    const observed = plugin === 'FolioleCompanionSync' || plugin === 'CapacitorSQLite';
+    if (!observed) return original.call(Capacitor, plugin, method, options);
+    const detail = options && typeof options === 'object' ? options : {};
+    const action = 'action' in detail && typeof detail.action === 'string' ? detail.action : undefined;
+    const record = { id: ++next, plugin, method, ...(action ? { action } : {}),
+      ...(method === 'postRequestSyncHttp' ? { attachment: 'attachment_receive' in detail } : {}) };
+    events.push({ ...record, phase: 'start', at: Date.now() });
+    try {
+      const result: unknown = await original.call(Capacitor, plugin, method, options);
+      events.push({ ...record, phase: 'finish', at: Date.now() });
+      return result;
+    } catch (error) {
+      events.push({ ...record, phase: 'error', at: Date.now(), error: String(error) });
+      throw error;
+    }
+  });
+  return { events, restore: () => Reflect.set(Capacitor, 'nativePromise', original) };
+}
