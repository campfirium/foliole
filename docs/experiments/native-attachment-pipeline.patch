@@ -0,0 +1,52 @@
+import type { AttachmentBlockResource } from '../../../../lib/core/sync/attachmentBlockReceiver.js';
+import type { pullRequestSyncAttachmentWindows } from '../../../../lib/core/sync/requestSyncAttachmentPull.js';
+import type { RequestSyncAttachmentHost } from '../../../../lib/core/sync/requestSyncAttachmentResponse.js';
+
+type Prepared = { resource: AttachmentBlockResource; initial: Awaited<ReturnType<RequestSyncAttachmentHost['status']>> } | null;
+type Outcome = Awaited<ReturnType<typeof pullRequestSyncAttachmentWindows>>;
+type Settled = { kind: 'ready'; value: Prepared } | { kind: 'failed'; error: unknown };
+type Input = {
+  keys: string[]; failed: Set<string>; pendingKeys: Set<string>; shouldYield(): boolean;
+  prepare(key: string): Promise<Prepared>;
+  pull(key: string, prepared: Promise<Prepared>): Promise<Outcome>;
+  attempt(key: string, execute: () => Promise<Outcome>): Promise<void>;
+};
+
+// Only preparation moves. Transfer and finalization remain in the native production pull.
+export async function runNativePreparedPulls(input: Input) {
+  let prepared: { key: string; result: Promise<Settled> } | undefined;
+  let attempted = false;
+  const prepare = (key: string) => {
+    record('prepare-start', key);
+    const result: Promise<Settled> = input.prepare(key).then(value => {
+      record('prepare-ready', key);
+      return { kind: 'ready', value };
+    }, (error: unknown) => ({ kind: 'failed', error }));
+    return { key, result };
+  };
+  try {
+    for (const [index, key] of input.keys.entries()) {
+      if (input.failed.has(key) || (attempted && input.shouldYield())) {
+        input.pendingKeys.add(key);
+        continue;
+      }
+      attempted = true;
+      const current = prepared?.key === key ? prepared : prepare(key);
+      prepared = undefined;
+      await input.attempt(key, async () => {
+        const ready = await current.result;
+        if (ready.kind === 'failed') throw ready.error;
+        const next = input.keys[index + 1];
+        if (next && !input.failed.has(next) && !input.shouldYield()) prepared = prepare(next);
+        record('pull-start', key);
+        try { return await input.pull(key, Promise.resolve(ready.value)); }
+        finally { record('pull-finish', key); }
+      });
+    }
+  } finally { await prepared?.result; }
+}
+
+function record(event: string, key: string) {
+  const events: unknown = Reflect.get(globalThis, '__t438PreparationEvents');
+  if (Array.isArray(events)) events.push({ event, key, at: Date.now() });
+}
diff --git a/.lab/prototypes/T438/real-path/native-prepared-window.ts b/.lab/prototypes/T438/real-path/native-prepared-window.ts
new file mode 100644
index 000000000..ab7d8ba46
--- /dev/null
+++ b/.lab/prototypes/T438/real-path/native-prepared-window.ts
@@ -0,0 +1,75 @@
+import { ATTACHMENT_BLOCK_BYTES, type AttachmentBlockResource } from '../../../../lib/core/sync/attachmentBlockReceiver.js';
+import { AttachmentReceivePaused, type AttachmentReceiveWindow } from '../../../../lib/core/sync/attachmentBlockTransfer.js';
+import { ATTACHMENT_WINDOW_BLOCKS, attachmentRequestSchema, type AttachmentRequest } from '../../../../lib/core/sync/requestSyncAttachmentContract.js';
+import type { RequestSyncAttachmentHost } from '../../../../lib/core/sync/requestSyncAttachmentResponse.js';
+import type { RequestSyncExchange } from '../../../../lib/core/sync/requestSyncDatabaseExchange.js';
+
+export type PreparedNativeWindow = { send(): Promise<AttachmentReceiveWindow>; close(): Promise<void> };
+export type NativePreparedExchange = RequestSyncExchange & { prepareAttachment?(query: AttachmentRequest): Promise<PreparedNativeWindow> };
+export type NativePreparation = { resource: AttachmentBlockResource;
+  initial: Awaited<ReturnType<RequestSyncAttachmentHost['status']>>; window?: PreparedNativeWindow } | null;
+type Settled = { kind: 'ready'; window: PreparedNativeWindow } | { kind: 'failed'; error: unknown };
+export type DispatchGate = { ready(): void; dispatch: Promise<void> };
+
+export function prepareNativeWindow(exchange: NativePreparedExchange, resource: AttachmentBlockResource, offset: number) {
+  if (!exchange.prepareAttachment) throw new Error('native_request_preparation_required');
+  return exchange.prepareAttachment(attachmentRequestSchema.parse({ ...resource,
+    requestId: crypto.getRandomValues(new Uint8Array(16)), operation: 'pull', offset, maxBlocks: ATTACHMENT_WINDOW_BLOCKS }));
+}
+
+export async function pullPreparedNativeWindows(host: RequestSyncAttachmentHost, exchange: NativePreparedExchange,
+  ready: NonNullable<NativePreparation>, shouldYield: () => boolean) {
+  if (!host.receiveWindow) throw new Error('attachment_window_receiver_missing');
+  const resource = ready.resource;
+  let offset = ready.initial.offset, blocks = 0;
+  let current = ready.window;
+  let next: Promise<Settled> | undefined;
+  try {
+    while (true) {
+      current ??= await prepareNativeWindow(exchange, resource, offset);
+      const active = current;
+      const planned = Math.min(resource.byteLength, offset + ATTACHMENT_WINDOW_BLOCKS * ATTACHMENT_BLOCK_BYTES);
+      let result;
+      try {
+        result = await host.receiveWindow(resource, offset, () => {
+          const operation = active.send();
+          if (planned < resource.byteLength && !shouldYield()) next = settle(prepareNativeWindow(exchange, resource, planned));
+          return operation;
+        });
+      } catch (error) {
+        if (!(error instanceof AttachmentReceivePaused)) throw error;
+        await host.status(resource);
+        return { complete: false, blocks };
+      } finally { await active.close(); current = undefined; }
+      blocks += result.blocks;
+      offset = result.offset;
+      if (offset === resource.byteLength) return { complete: true, blocks };
+      if (!result.blocks) return { complete: false, blocks, verificationPending: true };
+      if (shouldYield()) return { complete: false, blocks };
+      if (next && offset === planned) {
+        const prepared = await next; next = undefined;
+        if (prepared.kind === 'failed') throw prepared.error;
+        current = prepared.window;
+      } else { await closeSettled(next); next = undefined; }
+    }
+  } finally { await current?.close(); await closeSettled(next); }
+}
+
+function settle(promise: Promise<PreparedNativeWindow>): Promise<Settled> {
+  return promise.then(window => ({ kind: 'ready', window }), (error: unknown) => ({ kind: 'failed', error }));
+}
+async function closeSettled(promise?: Promise<Settled>) {
+  const result = await promise;
+  if (result?.kind === 'ready') await result.window.close();
+}
+
+export async function waitForNativeDispatch(gate: DispatchGate, signal?: AbortSignal) {
+  signal?.throwIfAborted();
+  let rejectAbort: (reason: unknown) => void = () => {};
+  const aborted = new Promise<void>((_resolve, reject) => { rejectAbort = reject; });
+  const abort = () => rejectAbort(signal?.reason);
+  signal?.addEventListener('abort', abort, { once: true });
+  gate.ready();
+  try { await Promise.race([gate.dispatch, aborted]); signal?.throwIfAborted(); }
+  finally { signal?.removeEventListener('abort', abort); }
+}
