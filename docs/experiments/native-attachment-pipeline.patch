+import { createHash } from 'node:crypto';
+import fs from 'node:fs/promises';
+import path from 'node:path';
+
+export async function stageNativeFinalization(repo, root) {
+  const changed = [];
+  const core = 'lib/core/sync/';
+  const framed = 'src/shared/platform/companion/sync/framed/';
+  async function write(relative, source) {
+    await fs.writeFile(path.join(root, relative), source);
+    changed.push({ path: relative, sha256: createHash('sha256').update(source).digest('hex') });
+  }
+  const helper = await fs.readFile(path.join(repo, '.lab/prototypes/T438/real-path/native-finalization.ts'), 'utf8');
+  await write(core + 't438NativeFinalization.ts', helper.replaceAll('../../../../lib/core/', '../'));
+  let host = await fs.readFile(path.join(root, framed + 'companionAttachmentBlockFiles.ts'), 'utf8');
+  if (!host.includes('  const receiver = createAttachmentBlockReceiver({') || !host.includes('  });\n  const inspect')) {
+    throw new Error('native_file_port_entry_changed');
+  }
+  host = "import type { NativeStagingHost } from '../../../../../../lib/core/sync/t438NativeFinalization.js';\n" + host;
+  host = host.replace('type AttachmentBlockResult }', 'type AttachmentBlockResult, type AttachmentBlockFiles }');
+  host = host.replace('  const receiver = createAttachmentBlockReceiver({', '  const blockFiles: AttachmentBlockFiles = {');
+  host = host.replace('  });\n  const inspect', '  };\n  const receiver = createAttachmentBlockReceiver(blockFiles);\n  const inspect');
+  host = host.replace('const host: RequestSyncAttachmentHost = {',
+    'const host: NativeStagingHost = {\n    staging: async () => ({ files: blockFiles, database: db, notify: notifyAttachmentResourceAvailable }),');
+  await write(framed + 'companionAttachmentBlockFiles.ts', host);
+  let exchange = await fs.readFile(path.join(root, framed + 'companionRequestSyncExchange.ts'), 'utf8');
+  exchange = "import type { NativeSignalExchange } from '../../../../../../lib/core/sync/t438NativeFinalization.js';\n" + exchange;
+  exchange = exchange.replace('): RequestSyncExchange {', '): NativeSignalExchange {');
+  exchange = exchange.replace('return { ...input,', 'return { withSignal: signal => createCompanionRequestSyncExchange(host, { ...input, signal }), ...input,');
+  exchange = exchange.replace("import type { RequestSyncExchange } from '../../../../../../lib/core/sync/requestSyncDatabaseExchange.js';\n", '');
+  await write(framed + 'companionRequestSyncExchange.ts', exchange);
+  let run = await fs.readFile(path.join(root, core + 'requestSyncAttachmentExchange.ts'), 'utf8');
+  run = run.replace('export async function exchangeRequestSyncAttachments(', 'async function runNativeExchangeBody(');
+  run = "import { createNativeFinalization, type NativeStagingHost, type NativeSignalExchange } from './t438NativeFinalization.js';\n" + run;
+  run += `\nexport async function exchangeRequestSyncAttachments(host: NativeStagingHost, exchange: NativeSignalExchange,
+  report: (key: string, error: unknown) => void, shouldYield = attachmentDataYield()) {
+  if (!exchange.receiveAttachment) return runNativeExchangeBody(host, exchange, report, shouldYield);
+  if (!exchange.withSignal) throw new Error('native_pipeline_signal_binding_required');
+  const pipeline = await createNativeFinalization(host, exchange.signal);
+  let failure: unknown;
+  try { return await runNativeExchangeBody(pipeline.host, exchange.withSignal(pipeline.signal), report, shouldYield); }
+  catch (error) { failure = error; throw error; }
+  finally { await pipeline.close(failure); }
+}\n`;
+  await write(core + 'requestSyncAttachmentExchange.ts', run);
+  return changed;
+}
