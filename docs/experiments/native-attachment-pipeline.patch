+        mimeType: 'image/png', originalName: path.basename(file.file) });
+      if (imported.status !== 'imported' || imported.storage_key !== file.key) throw new Error('production_import_failed');
+      references.push({ storage_key: imported.storage_key, original_name: imported.original_name, role: 'image' });
+    }
+    payload.content = input.files.map(file => `![T438](asset://${file.key})`).join('\n\n');
+    await invoke('update_node_content_with_anchors', { parent: payload, affectedAnchors: [], edit: {
+      baseVersionId: created.nodes.find(node => node.nodeId === nodeId).currentVersionId,
+      versionId: randomUUID(), newImageReferences: references } });
+    }
+    const deviceId = await runWithDatabaseConnectionOwner(() => loadOrCreateDesktopDeviceId());
+    const server = await ensureLanWorkspaceSyncServer({ appVersion: '0.7.16', deviceId });
+    if (server.state !== 'running' || server.port !== 38645) throw new Error('production_source_not_listening');
+    await fs.writeFile(path.join(root, 'source-shell-ready.json'), JSON.stringify({ nodeId, server,
+      files: input.files.map(({ key, bytes }) => ({ key, bytes })), productWindows: 0, at: Date.now() }, null, 2));
+    console.log('T438 source ready without product windows');
+    await new Promise(resolve => { process.once('SIGINT', resolve); process.once('SIGTERM', resolve); });
