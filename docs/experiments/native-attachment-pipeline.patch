+    const payload = { nodeId, parentNodeId: 'special-inbox', kind: 'topic', title: 'T438 native receive prototype',
+      isTitleManual: true, content: '', reveal: null, anchorLink: null, position: snapshot.nodeOrder.length,
+      nodeOrder: [...snapshot.nodeOrder, nodeId], createdAt: stamp, updatedAt: stamp };
+    const created = await invoke('create_topic', payload);
+    const references = [];
