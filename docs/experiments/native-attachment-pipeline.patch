+import { runCompanionSyncCoordinator } from '../../../../src/companion/companionSyncCoordinator';
+import { getIosCompanionDatabaseOwner } from '../../../../src/shared/platform/companion/runtime/iosCompanionDatabaseBootstrap';
+import { ensureCompanionSyncGroupDataOwner } from '../../../../src/shared/platform/companion/sync/syncGroupProviderDataOwner';
+import { loadCompanionBootstrapState } from '../../../../src/shared/platform/companionBootstrap';
+import { loadCompanionWorkspaceSyncState } from '../../../../src/shared/platform/companionWorkspaceSync';
+
+import { auditNativeFiles, resetNativeExperimentCopies } from './native-audit';
+import { observeNativeCalls } from './native-observation';
+import { shellResultPhase } from './shell-result-phase';
+
+// This entry replaces only the product UI in a copied build. All work stays in production modules.
+const root = document.getElementById('root');
+if (!root) throw new Error('shell_root_missing');
+const result = document.createElement('textarea');
+result.dataset.testid = 't438-result';
+result.rows = 20;
+result.cols = 45;
+result.readOnly = true;
+const start = document.createElement('button');
+const audit = document.createElement('button');
+const reset = document.createElement('button');
+reset.textContent = 'Reset experiment copies';
+reset.dataset.testid = 't438-reset';
+reset.disabled = true;
+audit.textContent = 'Verify received files';
+audit.dataset.testid = 't438-audit';
+audit.disabled = true;
+const expected: { key: string; bytes: number }[] = [];
+start.textContent = 'Run production sync';
+start.dataset.testid = 't438-run';
+start.disabled = true;
+root.replaceChildren(start, audit, reset, result);
+const observation = observeNativeCalls();
+Reflect.set(globalThis, '__t438PreparationEvents', []);
+const milestones: { phase: string; at: number; detail?: unknown }[] = [];
+function publish(phase: string, detail?: unknown) {
+  milestones.push({ phase, at: Date.now(), detail });
+  phase = shellResultPhase(result.dataset.phase, phase);
+  result.value = JSON.stringify({ phase, milestones, native: observation.events,
+    preparation: Reflect.get(globalThis, '__t438PreparationEvents') });
+  result.dataset.phase = phase;
+}
+let state: Awaited<ReturnType<typeof loadCompanionWorkspaceSyncState>>;
+async function bootstrap() {
+  publish('booting');
+  const bootstrapState = await loadCompanionBootstrapState();
+  if (bootstrapState.runtime_kind !== 'android-capacitor') throw new Error('android_native_required');
+  await ensureCompanionSyncGroupDataOwner();
+  state = await loadCompanionWorkspaceSyncState();
+  publish('ready', { runtime: bootstrapState.runtime_kind, endpoint: state.endpoint_url });
+  start.disabled = false;
+  audit.disabled = false;
+  reset.disabled = false;
+}
+reset.onclick = async () => {
+  reset.disabled = true;
+  try { publish('reset-finished', await resetNativeExperimentCopies(expected)); }
+  catch (error) { publish('reset-failed', String(error)); }
+  finally { reset.disabled = false; }
+};
+audit.onclick = async () => {
+  audit.disabled = true;
+  try { publish('audit-passed', await auditNativeFiles(expected)); }
+  catch (error) { publish('audit-failed', String(error)); }
+  finally { audit.disabled = false; }
+};
+start.onclick = async () => {
+  start.disabled = true;
+  publish('running');
+  try {
+    const outcome = await runCompanionSyncCoordinator({
+      state, cancelled: () => false, triggerReason: 'manual',
+      setState: update => { state = typeof update === 'function' ? update(state) : update; },
+      setError: error => { if (error) publish('sync-error', error); },
+      setStatus: status => publish('status', status),
+      setSyncProgress: progress => { if (progress) publish('progress', progress); }
+    });
+    const proof = await getIosCompanionDatabaseOwner().readSnapshot(async db => ({
+      pending: await db.query('SELECT COUNT(*) AS count FROM attachment_pending'),
+      available: await db.query('SELECT COUNT(*) AS count FROM framed_sync_resource_availability WHERE available = 1')
+    }));
+    publish('finished', { outcome, proof });
+  } catch (error) { publish('failed', String(error)); }
+  finally { start.disabled = false; }
+};
+void bootstrap().catch(error => publish('failed', String(error)));
