#!/bin/sh
set -eu

FOLIOLE_CLI_BIN_DIR=$(CDPATH= cd "$(dirname "$0")" && pwd)
FOLIOLE_CLI_CONTENTS_DIR=$(dirname "$FOLIOLE_CLI_BIN_DIR")

: "${FOLIOLE_AGENT_DESCRIPTOR:=$HOME/Library/Containers/com.campfirium.foliole/Data/Library/Application Support/foliole/cache/agent-control-session.json}"
: "${FOLIOLE_PRODUCT_METADATA_PATH:=$FOLIOLE_CLI_CONTENTS_DIR/Resources/app.asar/package.json}"

export ELECTRON_RUN_AS_NODE=1
export FOLIOLE_AGENT_DESCRIPTOR
export FOLIOLE_PRODUCT_METADATA_PATH

exec "$FOLIOLE_CLI_CONTENTS_DIR/MacOS/Foliole" \
  "$FOLIOLE_CLI_CONTENTS_DIR/Resources/scripts/agent-control/foliole-agent.mjs" "$@"
