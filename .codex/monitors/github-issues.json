{
  "schemaVersion": 1,
  "name": "github-issues",
  "enabled": true,
  "kind": "github-issue-handoff",
  "template": ".codex/monitors/templates/github-issues.md",
  "defaultPriority": "normal",
  "defaultTtlSeconds": 1800,
  "pollIntervalSeconds": 900,
  "repository": "campfirium/foliole",
  "limit": 50,
  "dedupeKeyPattern": "foliole:github-issue:{eventId}",
  "notes": "Opens one paused Codex Desktop handoff with the complete issue prompt for each newly observed open issue."
}
