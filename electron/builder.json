{
  "appId": "com.campfirium.foliole",
  "productName": "Foliole",
  "copyright": "Copyright (c) 2026 Foliole",
  "directories": {
    "output": "artifacts/windows"
  },
  "electronDist": "node_modules/electron/dist",
  "extraMetadata": {
    "folioleBuildChannel": "github"
  },
  "asar": true,
  "asarUnpack": [
    "**/node_modules/better-sqlite3/build/Release/*.node",
    "**/node_modules/@foliole/macos-security-bookmarks/build/Release/*.node"
  ],
  "extraResources": [
    {
      "from": "build/icon.ico",
      "to": "build/icon.ico"
    },
    {
      "from": "build/FolioleStatusTemplate.png",
      "to": "build/FolioleStatusTemplate.png"
    },
    {
      "from": "build/FolioleStatusTemplate@2x.png",
      "to": "build/FolioleStatusTemplate@2x.png"
    },
    {
      "from": "scripts/agent-control",
      "to": "scripts/agent-control"
    }
  ],
  "extraFiles": [
    {
      "from": "build/cli",
      "to": "bin"
    }
  ],
  "electronLanguages": ["en-US", "zh-CN"],
  "npmRebuild": true,
  "nativeRebuilder": "sequential",
  "publish": [
    {
      "provider": "github",
      "owner": "campfirium",
      "repo": "foliole",
      "releaseType": "release"
    }
  ],
  "files": [
    "build/icon.png",
    "build/icon-macos.png",
    "dist/desktop/**/*",
    "electron/preload.cjs",
    "electron/globalCapturePanelPreload.cjs",
    "electron/globalCaptureToastPreload.cjs",
    "dist/electron/**/*",
    "dist/lib/**/*",
    "dist/scripts/agent-control/foliole-agent-routes.mjs",
    "dist/scripts/agent-control/foliole-agent-runtime-paths.mjs",
    "dist/src/shared/config/**/*",
    "package.json",
    "!dist/electron/**/*.test.js",
    "!dist/electron/**/*.test.helpers.js",
    "!dist/electron/**/*test-support.js",
    "!dist/lib/**/*.test.js",
    "!dist/lib/**/*.test.helpers.js",
    "!dist/lib/**/*test-support.js",
    "!node_modules/@codemirror/**",
    "!node_modules/@capacitor/**",
    "!node_modules/@capacitor-community/**",
    "!node_modules/@mermaid-js/**",
    "!node_modules/@radix-ui/**",
    "!node_modules/@rollup/**",
    "!node_modules/@stencil/**",
    "!node_modules/@tanstack/**",
    "!node_modules/clsx/**",
    "!node_modules/cytoscape/**",
    "!node_modules/cytoscape-fcose/**",
    "!node_modules/d3/**",
    "!node_modules/dagre-d3-es/**",
    "!node_modules/jeep-sqlite/**",
    "!node_modules/katex/**",
    "!node_modules/lucide-react/**",
    "!node_modules/mermaid/**",
    "!node_modules/react/**",
    "!node_modules/react-dom/**",
    "!node_modules/react-pdf/**",
    "!node_modules/roughjs/**",
    "!node_modules/sql.js/**",
    "!node_modules/tailwind-merge/**",
    "!node_modules/zustand/**",
    "!node_modules/better-sqlite3/deps/**",
    "!node_modules/better-sqlite3/src/**",
    "!node_modules/pdfjs-dist/build/**",
    "!node_modules/pdfjs-dist/legacy/**/*.map",
    "!node_modules/pdfjs-dist/legacy/web/**",
    "!node_modules/pdfjs-dist/web/**",
    "!node_modules/pdfjs-dist/**/*.d.mts",
    "!node_modules/vitest/**"
  ],
  "win": {
    "icon": "build/icon.ico",
    "target": ["nsis"],
    "requestedExecutionLevel": "asInvoker",
    "artifactName": "${productName}-Windows-${arch}-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "include": "build/installer.nsh",
    "allowToChangeInstallationDirectory": true,
    "perMachine": false,
    "createStartMenuShortcut": true,
    "createDesktopShortcut": true,
    "runAfterFinish": true,
    "shortcutName": "Foliole"
  },
  "linux": {
    "artifactName": "${productName}-Linux-Experimental-amd64-${version}.${ext}",
    "icon": "build/icon.png",
    "target": ["deb"],
    "category": "Education"
  },
  "deb": {
    "afterInstall": "build/linux/after-install.sh",
    "afterRemove": "build/linux/after-remove.sh",
    "appArmorProfile": "build/linux/apparmor-profile",
    "packageName": "foliole"
  },
  "mac": {
    "icon": "build/icon.icns",
    "target": ["dmg", "zip"],
    "category": "public.app-category.education",
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown Document",
        "role": "Editor",
        "rank": "Alternate"
      }
    ]
  }
}
