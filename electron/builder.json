{
  "appId": "com.foliole.desktop",
  "productName": "Foliole",
  "copyright": "Copyright (c) 2026 Foliole",
  "directories": {
    "output": "release"
  },
  "asar": true,
  "asarUnpack": [
    "**/node_modules/better-sqlite3/**"
  ],
  "npmRebuild": true,
  "nativeRebuilder": "sequential",
  "files": [
    "dist/**/*",
    "electron-dist/**/*",
    "package.json"
  ],
  "fileAssociations": [
    {
      "description": "Markdown document",
      "ext": ["md", "markdown"],
      "name": "Markdown Document",
      "role": "Viewer"
    }
  ],
  "win": {
    "target": ["nsis"],
    "requestedExecutionLevel": "asInvoker"
  },
  "nsis": {
    "perMachine": true
  },
  "linux": {
    "target": ["AppImage"],
    "category": "Education"
  },
  "mac": {
    "target": ["dmg"],
    "category": "public.app-category.education"
  }
}
