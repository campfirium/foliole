{
  "appId": "com.foliole.desktop",
  "productName": "Foliole",
  "copyright": "Copyright (c) 2026 Foliole",
  "directories": {
    "output": "release"
  },
  "asar": true,
  "asarUnpack": [
    "**/node_modules/better-sqlite3/**"
  ],
  "npmRebuild": true,
  "nativeRebuilder": "sequential",
  "files": [
    "dist/**/*",
    "electron-dist/**/*",
    "package.json"
  ],
  "win": {
    "target": ["nsis"],
    "requestedExecutionLevel": "asInvoker"
  },
  "linux": {
    "target": ["AppImage"],
    "category": "Education"
  },
  "mac": {
    "target": ["dmg"],
    "category": "public.app-category.education"
  }
}
