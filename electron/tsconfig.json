{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "allowJs": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "../dist",
    "rootDir": "..",
    "types": ["node"]
  },
  "include": ["./**/*.ts", "../lib/**/*.ts", "../scripts/agent-control/foliole-agent-routes.mjs"],
  "exclude": ["../lib/core/database/androidCompanion*.ts"]
}
