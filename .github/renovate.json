{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "npm",
    "gradle",
    "gradle-wrapper",
    "swift"
  ],
  "baseBranchPatterns": [
    "dev"
  ],
  "timezone": "Asia/Shanghai",
  "automerge": false,
  "dependencyDashboard": false,
  "vulnerabilityAlerts": {
    "enabled": false
  },
  "rangeStrategy": "pin",
  "ignorePaths": [
    "**/node_modules/**",
    ".lab/**",
    ".tmp/**",
    ".cache/**",
    "ios/App/CapApp-SPM/**",
    "android/capacitor.settings.gradle",
    "android/app/capacitor.build.gradle"
  ],
  "packageRules": [
    {
      "description": "Match the existing npm installation release-age policy.",
      "matchManagers": [
        "npm"
      ],
      "minimumReleaseAge": "7 days"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "@capacitor/**",
        "@capacitor-community/sqlite"
      ],
      "groupName": "capacitor"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "@codemirror/**",
        "@lezer/**"
      ],
      "groupName": "editor"
    },
    {
      "matchManagers": [
        "swift"
      ],
      "matchPackageNames": [
        "apple/swift-protobuf"
      ],
      "groupName": "swift-protobuf"
    },
    {
      "description": "Electron follows the existing latest-stable review policy.",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "electron"
      ],
      "minimumReleaseAge": "0 days"
    }
  ]
}
