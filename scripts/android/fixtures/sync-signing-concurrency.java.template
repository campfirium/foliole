package com.foliole.android;
    import java.util.concurrent.*;
    @interface PluginMethod {}
    class PluginCall {
      final CompletableFuture<Object> result = new CompletableFuture<>();
      void resolve(Object value) { result.complete(value); }
      void reject(String message, Exception cause) { result.completeExceptionally(cause); }
    }
    class FolioleCompanionSyncAsync {
      interface Work { Object run() throws Exception; }
      static void run(ExecutorService executor, PluginCall call, String message, Work work) {
        executor.execute(() -> {
          try { call.resolve(work.run()); }
          catch (Exception error) { call.reject(message, error); }
        });
      }
    }
    class FolioleCompanionSyncGroupSigning {
      static final CountDownLatch entered = new CountDownLatch(1);
      static final CompletableFuture<Object> credential = new CompletableFuture<>();
      static Object sign(Object context, PluginCall call) throws Exception {
        entered.countDown();
        return credential.get(3, TimeUnit.SECONDS);
      }
    }
    class FolioleAttachmentMaintenanceFiles {
      static Object execute(Object context, PluginCall call) { return "files-complete"; }
    }
